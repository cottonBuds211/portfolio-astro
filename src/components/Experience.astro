---
import type { CollectionEntry } from "astro:content";

interface Props {
  expEntry: CollectionEntry<"experience">;
}

const { expEntry } = Astro.props;
const { date, position, company } = expEntry.data;
---

<div class="relative flex flex-col ext-text">
  <header>
    <p class="text-sm">{date}</p>

    <h6 class="text-h6 text-primary dark:text-secondary">
      {company}
    </h6>
    <p class="text-sm mb-2 uppercase">{position}</p>
  </header>
  <div class="prose-sm">
    <slot />
  </div>
</div>

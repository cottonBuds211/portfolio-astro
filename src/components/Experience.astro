---
const { date, position, company, description } = Astro.props;
---

<div class="relative flex flex-col">
  <header>
    <p class="text-text-secondary">{date}</p>

    <h6 class="text-h6">
      {position} @ {company}
    </h6>
  </header>

  {
    Array.isArray(description) ? (
      <ul class="list-disc pl-4 text-text-secondary space-y-1">
        {description.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    ) : (
      <p class="text-text-secondary">{description}</p>
    )
  }
</div>

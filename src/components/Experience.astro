---
const { date, position, company, description } = Astro.props;
---

<div class="relative flex flex-col ext-text">
  <header>
    <p class="text-sm">{date}</p>

    <h6 class="text-h6 text-primary dark:text-secondary">
      {company}
    </h6>
    <p class="text-sm mb-2 uppercase">{position}</p>
  </header>

  {
    Array.isArray(description) ? (
      <ul class="list-disc pl-4 space-y-1">
        {description.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    ) : (
      <p >{description}</p>
    )
  }
</div>

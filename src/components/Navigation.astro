---
import DarkModeToggle from "./DarkModeToggle.astro";
import MenuIcon from "./MenuIcon.astro";
import Modal from "./Modal.astro";
import SunIcon from "./SunIcon.astro";

const navLinks = [
  {
    title: "Experience",
    link: "experience",
  },
  { title: "Projects", link: "projects" },
];
---

<div class="h-full flex items-center mx-4 justify-between text-primary dark:text-secondary">
  <div class="relative inline-block">
  <span class="absolute inset-0 rounded-lg bg-primary/50 dark:bg-secondary/50 -z-10 translate-x-1 translate-y-1"></span>
  <a
    class="w-10 h-10 font-bold bg-white rounded-lg flex justify-center items-center  cursor-pointer hover:translate-x-1 hover:translate-y-1 hover:shadow-sm transition ease-linear duration-150"
    href="#top"
  >
    <span class="text-gray-800"> MD </span>
  </a>
  </div>

  <div class="hidden md:flex gap-3 h-full items-center">
    {
      navLinks.map((link) => (
        <a
          class="relative link group hover:cursor-pointer h-full flex items-center"
          href={`#${link.link}`}
        >
          {link.title}
          <span class="absolute left-1/2 right-1/2 -bottom-0.5 h-0.5 bg-primary/50 dark:bg-secondary transform -translate-x-1/2 transition-all duration-300 group-hover:w-full w-0" />
        </a>
      ))
    }
  </div>
  <div class="flex gap-2">
    <DarkModeToggle />
  <div class="flex md:hidden">
    <Modal>
      <div slot="trigger">
        <button class="p-2 h-10 w-10 border border-primary/10 dark:border-white/10 rounded-lg hover:cursor-pointer text-text dark:text-secondary transition duration-200" aria-label="Toggle dark mode" type="button">    
                    <MenuIcon />
 
    </button>
      </div>
      <main
        slot="main"
        class="flex h-[90vh] justify-center items-center text-center"
      >
        <div class="flex flex-col w-full">
          {
            navLinks.map((link) => (
              <a
                @click="$refs.modal.close(); open = false"
                href={`#${link.link}`}
                class="w-full lg:w-fit "
              >
                {link.title}
              </a>
            ))
          }
        </div>
      </main>
    </Modal>
  </div>
  </div>
</div>

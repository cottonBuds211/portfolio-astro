---
import MenuIcon from "./MenuIcon.astro";
import Modal from "./Modal.astro";
import SunIcon from "./SunIcon.astro";

const navLinks = [
  {
    title: "Experience",
    link: "experience",
  },
  { title: "Projects", link: "projects" },
];
---

<div class="h-full flex items-center mx-4 justify-between">
  <a
    class="w-10 h-10 font-bold bg-white rounded-lg flex justify-center items-center shadow-md cursor-pointer hover:scale-120 hover:rotate-360 transition ease-linear duration-150"
    href="#top"
  >
    <span class="text-gray-800"> MD </span>
  </a>

  <div class="hidden md:flex gap-3 h-full items-center">
    {
      navLinks.map((link) => (
        <a
          class="relative link group hover:cursor-pointer h-full flex items-center"
          href={`#${link.link}`}
        >
          {link.title}
          <span class="absolute left-1/2 right-1/2 -bottom-0.5 h-0.5 bg-black/50 transform -translate-x-1/2 transition-all duration-300 group-hover:w-full w-0" />
        </a>
      ))
    }
  </div>
  <!-- <SunIcon className="stroke-1" /> -->

  <div class="flex md:hidden">
    <Modal>
      <div slot="trigger">
        <MenuIcon />
      </div>
      <main
        slot="main"
        class="flex h-[90vh] justify-center items-center text-center"
      >
        <div class="flex flex-col w-full">
          {
            navLinks.map((link) => (
              <a
                @click="$refs.modal.close(); open = false"
                href={`#${link.link}`}
                class="w-full lg:w-fit "
              >
                {link.title}
              </a>
            ))
          }
        </div>
      </main>
    </Modal>
  </div>
</div>

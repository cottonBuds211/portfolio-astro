---
import LinkIcon from "./LinkIcon.astro";
import Modal from "./Modal.astro";
import Image from "astro/components/Image.astro";

const { date, title, description, link, img, vid } = Astro.props;
---

<Modal>
  <div
    slot="trigger"
    class="min-w-70 min-h-75 h-full bg-white border border-black/10 hover:shadow-lg hover:cursor-pointer"
  >
    <Image
      src={img}
      alt=""
      class="h-full w-full bg-transparent object-cover shadow-inner"
      format="png"
    />
    <article class="flex flex-1 p-6 flex-col gap-2 h-40">
      <header class="flex justify-between">
        <h6 class="text-p">{title}</h6>
        <a
          class="cursor-pointer text-text-primary"
          href={link}
          target="_blank"
          rel="noopener noreferrer"
        >
          <LinkIcon
            class="h-5 w-5 text-black/50 hover:text-black stroke-2"
            aria-hidden="true"
            focusable="false"
          />
        </a>
      </header>
      <p class="text-sm text-text-secondary">{date}</p>
      <p class="text-sm text-text-secondary">{description}</p>
    </article>
  </div>
  <section slot="main" class="w-full h-full p-3 lg:p-10 lg:pt-0">
    <h4 class="text-text-primary">{title}</h4>
    <p class="text-text-secondary">{description}</p>
    <hr class="my-2 text-black/10" />

    <video
      autoplay
      muted
      loop
      playsinline
      width="100%"
      aria-label=`Video demo of ${title}`
    >
      <source src={vid} type="video/mp4" />
      Your browser does not support the video tag.
    </video>
  </section>
</Modal>

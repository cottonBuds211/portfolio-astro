---
import type { CollectionEntry } from "astro:content";
import LinkIcon from "./icons/LinkIcon.astro";
import Modal from "./ui/Modal.astro";
import { Image } from "astro:assets";
import Pill from "./ui/Pill.astro";

interface Props {
  projEntry: CollectionEntry<"projects">;
}

const { projEntry } = Astro.props;
const { date, title, link, img, vid, technology } = projEntry.data;
---

<Modal>
  <div
    slot="trigger"
    class="min-w-[35ch] min-h-100 h-full bg-secondary dark:bg-primary border border-primary/10 hover:border-accent/80 dark:border-secondary/10 hover:cursor-pointer transition duration-300 rounded-sm"
  >
    <Image
      src={img}
      alt=""
      class="h-full w-full bg-transparent object-cover brightness-90"
      format="png"
    />
    <article class="flex flex-1 p-6 flex-col gap-2 h-40">
      <header class="flex justify-between h-full">
        <h6 class="text-p text-primary dark:text-secondary">{title}</h6>
        <a
          class="cursor-pointer"
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visit Github"
        >
          <LinkIcon
            class="h-5 w-5 text-primary/50 hover:text-accent dark:text-secondary/50 stroke-2"
            aria-hidden="true"
            focusable="false"
          />
        </a>
      </header>
      <p class="text-sm">{date}</p>
      <div class="prose-sm">
        <slot />
      </div>
      <div class="flex flex-wrap gap-1">
        {technology.map((tech: string) => <Pill title={tech} />)}
      </div>
    </article>
  </div>

  <Modal>
    <div
      slot="trigger"
      class="relative group transition-all duration-300 hover:cursor-pointer shadow-2xl rounded-lg"
    >
      <img src={img.src} class="object-cover rounded-lg" loading="lazy" />
      <span
        class="absolute inset-0 flex justify-center items-center text-white bg-black/40 opacity-0 group-hover:opacity-100 transition-all duration-200 ease-in"
        ><svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-eye-icon lucide-eye"
          ><path
            d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"
          ></path><circle cx="12" cy="12" r="3"></circle></svg
        ></span
      >
      <LinkIcon
        class="h-6 w-6 text-primary/50 hover:text-accent dark:text-secondary/50 stroke-2"
        aria-hidden="true"
        focusable="false"
      />
    </div>
  </Modal>
  <div class="prose-sm">
    <slot />
  </div>
  <div class="flex gap-2 mt-2">
    {technology.map((tech: string) => <Pill title={tech} />)}
  </div>
  <hr class="my-2 text-primary/10 dark:text-secondary/10" />

  <video
    autoplay
    muted
    loop
    playsinline
    width="100%"
    aria-label=`Video demo of ${title}`
  >
    <source src={vid} type="video/mp4" />
    Your browser does not support the video tag.
  </video>
</Modal>

---
import LinkIcon from "./LinkIcon.astro";
import Modal from "./Modal.astro";
import Image from "astro/components/Image.astro";
import Technology from "./Technology.astro";

const { date, title, description, link, img, vid, technology } = Astro.props;
---

<Modal>
  <div
    slot="trigger"
    class="min-w-70 min-h-75 h-full bg-secondary dark:bg-primary border border-primary/10 hover:border-primary/30 dark:border-secondary/10 hover:dark:border-secondary/30 hover:cursor-pointer transition duration-300 rounded-sm "
  >
    <Image
      src={img}
      alt=""
      class="h-full w-full bg-transparent object-cover shadow-inner"
      format="png"
    />
    <article class="flex flex-1 p-6 flex-col gap-2 h-40 ">
      <header class="flex justify-between">
        <h6 class="text-p text-primary dark:text-secondary">{title}</h6>
        <a
          class="cursor-pointer"
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visit Github"
        >
          <LinkIcon
            class="h-5 w-5 text-primary/50 hover:text-primary dark:text-secondary/50 hover:dark:text-secondary stroke-2"
            aria-hidden="true"
            focusable="false"
          />
        </a>
      </header>
      <p class="text-sm">{date}</p>
      <p class="text-sm">{description}</p>
    </article>
  </div>
  <section slot="main" class="w-full h-full p-3 lg:p-10 lg:pt-0 bg-secondary dark:bg-primary">
    <h4 class="text-primary dark:text-secondary text-h4 font-semibold">{title}</h4>
    <p>{description}</p>
    <div class="flex gap-2 mt-2">
      {technology.map((tech: string) => <Technology title={tech} className="px-2 py-2 text-sm"/>)}
    </div>
    <hr class="my-2 text-primary/10 dark:text-secondary/10" />

    <video
      autoplay
      muted
      loop
      playsinline
      width="100%"
      aria-label=`Video demo of ${title}`
    >
      <source src={vid} type="video/mp4" />
      Your browser does not support the video tag.
    </video>
  </section>
</Modal>

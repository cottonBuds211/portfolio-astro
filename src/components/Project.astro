---
import EyeIcon from "./EyeIcon.astro";
import LinkIcon from "./LinkIcon.astro";
import Modal from "./Modal.astro";
import Image from "astro/components/Image.astro";

const { date, title, description, link, img, vid } = Astro.props;
---

<div
  class="flex flex-col lg:flex-row gap-4 justify-between  pl-4 transition-all ease-in duration-200 cursor-default"
>
  <article class="flex flex-1 flex-col gap-2">
    <header>
      <h6 class="text-h6">{title}</h6>
      <p class="text-text-secondary">{date}</p>
    </header>
    <p class="text-text-secondary">{description}</p>
    <a
      class="flex gap-2 items-center cursor-pointer text-text-primary "
      href={link}
      target="_blank"
      rel="noopener noreferrer"
      >
      <span class="hover:border-b hover:border-dotted hover:border-text-secondary">{new URL(link).hostname}</span>
      <LinkIcon class="h-4 w-4" aria-hidden="true" focusable="false"/>
    </a>
  </article>

  <Modal>
    <div
      slot="trigger"
      class="relative group transition-all duration-300 hover:cursor-pointer shadow-2xl"
    >
      <Image src={img} alt="" class="object-cover" format="png"/>
      <span
        class="absolute inset-0 flex justify-center items-center text-white bg-black/40 opacity-0 group-hover:opacity-100 transition-all duration-200 ease-in"
        >
       <EyeIcon class="h-4 w-4" aria-hidden="true" focusable="false" />
      </span>
    </div>
    <section slot="main" class="w-full h-full p-3 lg:p-10 lg:pt-0">
      <h4 class="text-text-primary">{title}</h4>
      <p class="text-text-secondary">{description}</p>
      <hr class="my-2 text-black/10" />

      <video autoplay muted loop playsinline width="100%" aria-label=`Video demo of ${title}`>
        <source src={vid} type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </sectoin>
  </Modal>
</div>

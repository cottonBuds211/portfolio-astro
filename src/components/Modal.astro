---
import Xicon from "./Xicon.astro";


---

<!-- TODO: PUT ANIMATION -->
<style>
  dialog {
    position: fixed;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  dialog::backdrop {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.3); /* optional: light dim */
  }
</style>

<div
  x-data="{open: false}"
   x-init="
    $watch('open', value => {
      document.body.classList.toggle('overflow-hidden', value)
    })
  "
  class="flex-1 w-fit overflow-hidden"
>
  <div @click="$refs.modal.showModal(); open=true">
    <slot name="trigger" />
  </div>
  <dialog
    x-ref="modal"
    @close="open = false"
    class="backdrop:backdrop-blur-xs lg:rounded-lg p-2 w-full h-full m-0 max-w-none max-h-none lg:h-fit lg:w-[65%] bg-secondary dark:bg-primary text-text dark:text-secondary z-50 outline-none"  
  >
  <div 
    x-show="open"
    x-cloak
    @click.outside="$refs.modal.close();"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 translate-y-2" 
    >
      <div class="w-full text-end">
        <button @click="$refs.modal.close(); open=false" class="text-primary dark:text-secondary p-3 cursor-pointer" 
          ><Xicon /></button
        >
      </div>
      <slot name="main" />
      </div>
  </dialog>
</div>

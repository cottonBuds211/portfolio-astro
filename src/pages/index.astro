---
import "../styles/global.css";
import { getCollection } from "astro:content";
import Button from "../components/ui/Button.astro";
import Experience from "../components/Experience.astro";
import GithubIcon from "../components/icons/GithubIcon.astro";
import LinkedInLogo from "../components/icons/LinkedInLogo.astro";
import Project from "../components/Project.astro";
import Technology from "../components/Technology.astro";
import { techStack } from "../data/techStack";
import Layout from "../layouts/Layout.astro";
import GmailIcon from "../assets/logos/gmail.png";
import Footer from "../components/Footer.astro";
import NavBar from "../components/NavBar.astro";
import type { TechStackItem } from "../types";

const experienceEntries = await getCollection("experience");
const projectEntries = await getCollection("projects");

const sortedExperience = experienceEntries.sort((a, b) =>
  b.id.localeCompare(a.id),
);
---

<Layout pageTitle="Manuel">
  <NavBar />
  <header id="top" class="flex justify-start md:justify-center">
    <div
      class="relative w-full max-w-[100ch] h-180 flex flex-col justify-center mx-4 md:mx-auto"
    >
      <div
        class="text-primary w-full dark:text-secondary font-semibold leading-12 md:leading-16 text-h5 md:text-h4"
      >
        <span class="font-dancing-script text-h4">Hi, I'm Manuel 👋</span>
        <br />
        <span class="description text-h1 md:text-[6rem] font-inter">
          a <span class="text-accent">full stack </span>developer
        </span>
      </div>
      <div class="subtitle flex flex-col gap-4 max-w-[40ch] mt-8">
        <p>
          I build modern web apps with tools like
          <span class="text-glow">
            React, Astro.js, Next.js & Tailwind CSS.
          </span>
        </p>
        <article class="contact-content col-span-4 mb-5">
          <span class="flex gap-4 md:gap-2 mt-2">
            <a
              href="https://github.com/cottonBuds211"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit Github"
            >
              <GithubIcon
                class="h-6 w-6 text-primary/70 hover:text-accent dark:text-secondary/70"
                aria-label="Visit Github profile"
              />
            </a>
            <a
              href="https://www.linkedin.com/in/manuel-john-dalacan-80406121b"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit LinkedIn"
            >
              <LinkedInLogo
                class="h-6 w-6 text-primary/70 hover:text-accent dark:text-secondary/70"
                aria-label="Visit LinkedIn profile"
              />
            </a>
          </span>
        </article>
        <div class="flex pt-4 gap-4">
          <Button
            title="Resumé"
            type="primary"
            link="/resume/ManuelJohnDalacan.pdf"
            target="_blank"
          />
          <Button title="Contact" link="#contact" />
        </div>
      </div>
      <div class="relative mt-5 overflow-hidden">
        <div
          class="absolute left-0 top-0 z-10 h-full w-24 bg-gradient-to-r from-secondary to-transparent dark:from-primary dark:to-transparent"
        >
        </div>
        <div class="flex w-max animate-scroll gap-12 py-6">
          {
            techStack.map((item: TechStackItem) => (
              <div class="gap-2 flex items-center">
                <img
                  src={item.logo}
                  class="w-4 h-4"
                  loading="eager"
                  fetchpriority="high"
                />
                <span class="text-md font-medium text-gray-500">
                  {item.title}
                </span>
              </div>
            ))
          }

          {
            techStack.map((item: TechStackItem) => (
              <div class="gap-2 flex items-center">
                <img
                  src={item.logo}
                  class="w-4 h-4"
                  loading="eager"
                  fetchpriority="high"
                />
                <span class="text-md font-medium text-gray-500">
                  {item.title}
                </span>
              </div>
            ))
          }
        </div>
        <div
          class="absolute right-0 top-0 z-10 h-full w-24 bg-gradient-to-lfrom-secondary to-transparent dark:from-primary dark:to-transparent"
        >
        </div>
      </div>
    </div>
  </header>
  <main class="max-w-[80ch] mx-4 md:mx-auto flex flex-col mb-10 gap-25">
    <section class="flex flex-col gap-8">
      <span id="projects" class="w-full h-px bg-primary/10"></span>

      <h5
        class="project-title col-span-1 text-h4 font-inter pb-10 text-primary dark:text-secondary"
      >
        Projects
      </h5>
      <div class="flex flex-wrap gap-4 mx-auto">
        {
          projectEntries.map(async (projEntry) => {
            const { Content } = await projEntry.render();
            return (
              <div class="w-[35ch] mx-auto">
                <Project projEntry={projEntry}>
                  <Content />
                </Project>
              </div>
            );
          })
        }
      </div>
    </section>

    <span id="experience" class="w-full h-px bg-primary/10"></span>

    <section class="flex flex-col">
      <h5
        class="experience-title col-span-1 text-h4 pb-10 text-primary dark:text-secondary"
      >
        Experiences
      </h5>
      <div class="flex flex-col mx-auto">
        {
          sortedExperience.map(async (expEntry) => {
            const { Content } = await expEntry.render();
            return (
              //Line beside experience
              <article
                class={`relative flex flex-col items-baseline ml-2 pl-6 pb-5 last:pb-0 border-l-2 border-accent/50 
                            before:content-[''] before:absolute before:w-3 before:h-3 before:bg-accent  before:rounded-full 
                            before:left-[-7px]`}
              >
                <Experience expEntry={expEntry}>
                  <Content />
                </Experience>
              </article>
            );
          })
        }
      </div>
    </section>
    <section>
      <h5 class="about-title text-h4 pb-10 text-primary dark:text-secondary">
        About Me
      </h5>
      <div
        class="about-me text-text-secondary px-5 gap-5 indent-8 lg:indent-0 leading-relaxed"
      >
        <p class="about-paragraph-1">
          I'm a junior full-stack developer working on web and automation
          projects for an offshore Japanese client, where I split time between
          front-end feature work in React/Next.js and building Python-based
          tools that automate manual business processes. I like the practical
          end of software turning a messy manual workflow or an unwieldy
          spreadsheet into something reliable people actually want to use.
          Longer term, I want to grow into a technical lead role, but for now
          I'm focused on getting good at both sides of the stack.
        </p>
      </div>
    </section>
    <span id="skills" class="w-full h-px bg-primary/10"></span>
    <section class="flex flex-col">
      <h5
        class="tech-title col-span-1 text-h4 pb-10 text-primary dark:text-secondary"
      >
        Technologies
      </h5>
      <!-- <HorizontalLine /> -->
      <article class="flex flex-wrap gap-2 mx-auto">
        {
          techStack.map((item) => (
            <div class="tech-button">
              <Technology
                color={item.color}
                title={item.title}
                logo={item.logo}
              />
            </div>
          ))
        }
      </article>
    </section>
    <span id="contact" class="w-full h-px bg-primary/10"></span>
    <section class="flex flex-col">
      <h5 class="contact-title text-h4 pb-10 text-primary dark:text-secondary">
        Contact
      </h5>
      <div class="flex flex-col gap-5">
        <p
          class="font-semibold text-sm uppercase text-primary dark:text-secondary"
        >
          Let's talk!
        </p>
        <Technology
          title={"dalacan.manuel96@gmail.com"}
          logo={GmailIcon.src}
          className={"text-primary dark:text-secondary text-shadow-2xs"}
        />
      </div>
    </section>
  </main>
  <Footer />

  <script>
    import { navAnimation } from "../animations/navAnimations";
    import { headerAnimation } from "../animations/headerAnimations";

    headerAnimation();
    navAnimation();
  </script>
</Layout>

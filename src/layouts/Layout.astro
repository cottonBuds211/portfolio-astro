---
import "../styles/global.css";

import LoadingScreen from "../components/LoadingScreen.astro";

const { pageTitle } = Astro.props;
---

<html lang="en" class="dark:bg-primary bg-secondary">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/logo.svg" />
    <title>{pageTitle}</title>
    <script>
      import Alpine from "alpinejs";
      Alpine.data("nav", () => ({
        top: true,
        init() {
          const update = () => {
            this.top = window.scrollY === 0;
          };
          update();
          window.addEventListener("scroll", update);
        },
      }));
      window.Alpine = Alpine;
      Alpine.start();
    </script>
    <script is:inline>
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;

      if (stored === "dark" || (!stored && prefersDark)) {
        document.documentElement.classList.add("dark");
      }
    </script>
    <script>
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }
    </script>
  </head>
  <!--  -->
  <body
    class="font-inter bg-secondary dark:bg-primary text-text dark:text-secondary/80 mx-3 md:mx-auto text-p"
  >
    <LoadingScreen />
    <slot />
  </body>
</html>
